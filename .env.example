# =============================================================================
# Freedom Hustle Guides — environment variables
# =============================================================================
# Copy to `.env.local` for local dev. In production (Vercel) and in Claude Code
# on the web, set these in the platform's environment-variable config instead —
# `.env.local` is gitignored and never leaves your machine / container.
#
# Only the variables the code actually reads are listed here. Everything is
# server-side only unless prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Notion (source of truth for guide content) -----------------------------
# Internal integration token from the Infinite Studio workspace.
# Without it, every Notion-backed section falls back to its MDX file in
# content/guides/<slug>/. Read in lib/notion.ts.
# The integration must be shared with the "Bangkok — The Freedom Hustle Guide"
# parent page (Notion → ••• → Connections → add the integration).
NOTION_TOKEN=

# --- Supabase (auth + membership store) --------------------------------------
# Magic-link auth and the `members` table (who bought what) live here.
# URL + anon key are used by the SSR client (middleware.ts); the service-role
# key bypasses RLS and is used server-side only (lib/members.ts, webhooks).
# NOTE: transactional email (the magic link) is sent by Supabase Auth's SMTP —
# configure Resend as the custom SMTP provider in the Supabase dashboard.
# There is no RESEND_API_KEY in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (checkout + purchase → access) -----------------------------------
# Test-mode keys are fine for dev. The webhook secret comes from the Stripe
# CLI (`stripe listen`) locally, or the dashboard endpoint in production.
# Read in lib/stripe.ts, app/api/checkout, app/api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two products. BANGKOK = single-guide; LIFETIME = all guides.
STRIPE_PRICE_BANGKOK=
STRIPE_PRICE_LIFETIME=

# --- Google Places (for <PlaceCard /> venue blocks) --------------------------
# Without this key, PlaceCard renders a basic link fallback. With it, a Google
# Maps URL auto-fills name, address, rating, and photo. Read in lib/places.ts.
# Setup: Google Cloud project → enable "Places API (New)" → create a key →
# restrict to your domain in production. Server-side only.
GOOGLE_PLACES_API_KEY=
